{
  "name": "openfox-devserver-status",
  "version": "0.2.0",
  "description": "Passive per-session dev-server status indicators for OpenFox",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "openfox": {
    "apiVersion": 2,
    "entry": "./dist/index.js",
    "displayName": "Dev Server Status",
    "description": "Shows the live dev-server state directly on OpenFox session rows.",
    "capabilities": [
      "ui",
      "hooks",
      "rpc"
    ],
    "timeoutMs": 5000
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && node --import tsx --test test/index.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
